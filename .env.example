MONGO_URI=
JWT_SECRET=
PORT=5000
MASTER_LOGIN_PASSWORD=
# Customer login link in quick-booking emails (default: https://zentrosure.com/login if unset and CLIENT_URL is *)
# LOGIN_WEB_URL=https://zentrosure.com/login

# Optional: send quick-booking login details (nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ZentroSure <noreply@example.com>"

# Public web origin (used to build logo URL in emails if EMAIL_LOGO_URL is unset). Avoid localhost for production mail.
# CLIENT_URL=https://zentrosure.com

# Email header logo: must be a public HTTPS URL (Gmail will not load localhost). Same file as autosure-hub `public/zentrosure-logo.png`.
# If unset: uses CLIENT_URL or LOGIN_WEB_URL origin + /zentrosure-logo.png, else zentrosure.com.
# EMAIL_LOGO_URL=https://zentrosure.com/zentrosure-logo.png

# Optional override for "View booking" link (default: origin of LOGIN_WEB_URL + /portal/bookings).
# PORTAL_BOOKINGS_URL=https://zentrosure.com/portal/bookings

# Cloudinary — image/video uploads (inspector booking media). Omit or set CLOUDINARY_ENABLED=false to use local disk.
# CLOUDINARY_ENABLED=true
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=zentrosure

# Inspector photo GPS vs customer-saved site: max distance in metres for "on-site verified" (default 500, clamped 50–5000).
# INSPECTION_SITE_MATCH_RADIUS_M=500

AISENSY_API_KEY=
AISENSY_CAMPAIGN_NAME=
# WhatsApp template for booking confirmation; templateParams order maps to $FirstName (use customer name from booking form)
AISENSY_BOOKING_CONFIRM_CAMPAIGN_NAME=booking_accept
AISENSY_BASE_URL=https://backend.aisensy.com/campaign/t1/api/v2
# Booking checkout WhatsApp (verify campaign: firstName, OTP, validity minutes)
AISENSY_VERIFY_CAMPAIGN_NAME=verify
AISENSY_VERIFY_USER_NAME=Zentroverse
AISENSY_VERIFY_SOURCE=new-landing-page form
# Admin assigns inspector → customer WhatsApp (template $FirstName = first name; destination = customer mobile)
AISENSY_ASSIGN_INSPECTOR_CAMPAIGN_NAME=assing_inspector
# AISENSY_ASSIGN_INSPECTOR_USER_NAME=Zentroverse
# AISENSY_ASSIGN_INSPECTOR_SOURCE=new-landing-page form
# Inspector submits/completes capture → notify customer (template params:
# [$FirstName, $inspectorName, $inspection_date, $inspection_url_shareable])
AISENSY_INSPECTION_CAMPAIGN_NAME=inspection
# AISENSY_INSPECTION_USER_NAME=Zentroverse
# AISENSY_INSPECTION_SOURCE=new-landing-page form

# Public share URL base override (default: <production-origin>/inspection/<bookingNumber>)
# PUBLIC_INSPECTION_WEB_URL=https://zentrosure.com/inspection

# Geoapify — reverse geocoding (GET /v1/geocode/reverse). Use a server key only.
# GEOAPIFY_TIMEOUT_MS=4500
GEOAPIFY_API_KEY=
